rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection
    match /projects/{projectId} {
      // Anyone can read projects on your public portfolio
      allow read: if true;
      
      // Only authenticated admin can create, update, or delete projects
      allow write: if request.auth != null;
    }

    // Certificates collection
    match /certificates/{certId} {
      // Anyone can read certificates on your public portfolio
      allow read: if true;

      // Only authenticated admin can create, update, or delete
      allow write: if request.auth != null;
    }
  }
}
